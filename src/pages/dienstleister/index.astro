---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';

const faq = [
  { q: 'Was kostet die Registrierung?', a: 'Nichts. Sie zahlen weder für die Registrierung noch pro Anfrage. Optional können Sie eine Premium-Platzierung buchen, um sichtbarer zu sein.' },
  { q: 'Welche Unterlagen brauche ich?', a: 'Gewerbeanmeldung oder Handelsregisterauszug und eine Betriebshaftpflichtversicherung. Zertifikate wie DIN EN ISO 9001 oder eine Innungsmitgliedschaft geben Sie gern zusätzlich an.' },
  { q: 'Wie viele Anfragen bekomme ich?', a: 'Das hängt von Region und Leistungen ab. Sie erhalten nur Anfragen, die zu Ihrem Einsatzgebiet und Ihren Leistungen passen.' },
  { q: 'Was sind BASETAGS?', a: 'Optionale Aufkleber in den Bereichen eines Objekts. Nacharbeiten kann das Team Ihres Kunden auch ohne sie per Handy melden. Mit einem BASETAG geht es schneller: scannen, Grund antippen, und Sie wissen sofort, wo und was.' },
];
---
<Base title="Neue Gewerbekunden für Reinigungsfirmen" description="Registrieren Sie Ihre Reinigungsfirma kostenlos bei Saubera: passende B2B-Anfragen ohne Lead-Gebühren, vergleichbare Leistungsverzeichnisse und Bewertungen pro Einsatz.">
  <section class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href="/">Start</a> / Für Reinigungsfirmen</div>
      <h1>Gewerbekunden gewinnen, ohne für Leads zu bezahlen</h1>
      <p class="lead">Registrieren Sie sich kostenlos und bekommen Sie Ausschreibungen, die zu Ihren Leistungen und Ihrem Gebiet passen.</p>
      <div class="btn-row mt-m"><a class="btn btn-primary" href="/dienstleister/registrieren">Kostenlos registrieren</a><a class="btn btn-ghost" href="/werben">Premium-Platzierung</a></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap editorial">
      <h2>Was anders ist</h2>
      <div class="editorial-body">
        <p>Viele Portale verkaufen dieselbe Anfrage an fünf Firmen und kassieren pro Kontakt, egal ob daraus ein Auftrag wird. Bei Saubera zahlen Sie dafür nichts. Wir verdienen an Werbung und an Premium-Platzierungen, die Sie buchen können, aber nicht müssen.</p>
        <dl class="facts">
          <dt>Keine Lead-Gebühren</dt><dd>Registrierung und Anfragen sind kostenlos, ohne Mindestlaufzeit.</dd>
          <dt>Schneller kalkulieren</dt><dd>Jede Anfrage kommt mit Leistungsverzeichnis: Fläche, Bereiche, Intervalle. Das spart Besichtigungen.</dd>
          <dt>Nur was passt</dt><dd>Sie legen Leistungen und Einsatzradius fest. Alles andere sehen Sie nicht.</dd>
          <dt>Bewertungen</dt><dd>Bewertungen pro Einsatz zeigen, dass Sie zuverlässig sind, und zählen bei der nächsten Ausschreibung.</dd>
          <dt>Nachweise digital</dt><dd>Einsätze abhaken statt Stundenzettel. Ihr Kunde sieht, was erledigt wurde.</dd>
          <dt>Nacharbeiten direkt</dt><dd>Das Team Ihres Kunden meldet per Handy direkt an Sie, optional per BASETAG.</dd>
        </dl>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap editorial">
      <h2>Wie Sie Partner werden</h2>
      <div class="editorial-body">
        <p>Sie legen Ihr Profil mit Firma, Leistungen, Einsatzgebiet und Ansprechperson an, das dauert ein paar Minuten. Wir prüfen Gewerbenachweis und Versicherung und schalten Sie frei. Danach landen passende Ausschreibungen bei Ihnen, und Sie entscheiden, worauf Sie anbieten.</p>
        <p><a class="link-strong" href="/dienstleister/registrieren">Zur Registrierung</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap editorial">
      <h2>Fragen von Reinigungsfirmen</h2>
      <div class="editorial-body"><Faq items={faq} /></div>
    </div>
  </section>
  <CtaBand title="Partner werden." text="Registrierung kostenlos, keine Mindestlaufzeit." href="/dienstleister/registrieren" label="Registrieren" />
</Base>
