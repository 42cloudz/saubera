---
// The public directory of approved cleaning companies, searchable by service, place and name.
import Base from '../../layouts/Base.astro';
import FirmenListe from '../../components/FirmenListe.astro';
import FirmenSuche from '../../components/FirmenSuche.astro';
import { leistungen, leistungBySlug } from '../../data/leistungen.ts';
import { bundeslaender, orteImLand, ortBySlug } from '../../data/orte.ts';
import { findFirmen, resolveWo } from '../../lib/firmen.ts';

export const prerender = false;

const q = Astro.url.searchParams;
const leistung = leistungBySlug.has(q.get('leistung') ?? '') ? q.get('leistung') : null;
// ?ort=<slug> from links, ?wo= from the search field.
const linked = ortBySlug.get(q.get('ort') ?? '');
const woRaw = (q.get('wo') ?? linked?.name ?? '').trim().slice(0, 60);
const { plz, ort } = resolveWo(woRaw);
const name = (q.get('name') ?? '').trim().slice(0, 80);
const unknownWo = woRaw !== '' && !plz;
const firmen = findFirmen({ leistung, plz, name });
const filtered = Boolean(leistung || plz || name);
const woText = ort ? ort.name : plz ? `PLZ ${plz}` : null;
const title = [leistung ? leistungBySlug.get(leistung)!.name : 'Reinigungsfirmen', woText && `in ${woText}`].filter(Boolean).join(' ');
const link = (o: { leistung?: string | null; ort?: string | null }) => {
  const p = new URLSearchParams();
  if (o.leistung) p.set('leistung', o.leistung);
  if (o.ort) p.set('ort', o.ort);
  const s = p.toString();
  return s ? `/firmen?${s}` : '/firmen';
};
const beliebt = ['berlin', 'hamburg', 'muenchen', 'koeln', 'frankfurt-am-main', 'stuttgart', 'duesseldorf', 'leipzig', 'hannover', 'nuernberg'];
---
<Base title={filtered ? title : 'Reinigungsfirmen finden'} description="Geprüfte Reinigungsfirmen für Unternehmen: nach Leistung, Ort und Postleitzahl suchen, merken und gemeinsam anfragen.">
  <section class="dir-head">
    <div class="wrap">
      <h1>{filtered ? title : 'Reinigungsfirmen finden'}</h1>
      <p class="lead">Geprüfte Betriebe für gewerbliche Objekte. Merken Sie sich passende Firmen und fragen Sie alle mit einer Anfrage an.</p>
      <FirmenSuche leistung={leistung} wo={woRaw} name={name} />
      <nav class="quick" aria-label="Nach Leistung filtern">
        <a href={link({ ort: ort?.slug })} class:list={{ 'is-on': !leistung }}>Alle</a>
        {leistungen.map((l) => <a href={link({ leistung: l.slug, ort: ort?.slug })} class:list={{ 'is-on': l.slug === leistung }}>{l.name}</a>)}
      </nav>
    </div>
  </section>
  <section class="dir-results">
    <div class="wrap">
      <div class="results-bar">
        <p><strong>{firmen.length}</strong> {firmen.length === 1 ? 'Firma' : 'Firmen'}{unknownWo && <span class="hint"> · „{woRaw}“ kennen wir noch nicht, bitte die PLZ eingeben</span>}</p>
        {filtered && <a href="/firmen">Filter zurücksetzen</a>}
      </div>
      <FirmenListe firmen={firmen} leistung={leistung} wo={woText} />
    </div>
  </section>
  <section class="section section-soft">
    <div class="wrap places">
      <h2>Reinigungsfirmen nach Ort</h2>
      <ul class="pill-list">{beliebt.map((s) => ortBySlug.get(s)!).map((o) => <li><a href={link({ leistung, ort: o.slug })}>{o.name}</a></li>)}</ul>
      <details class="all-places">
        <summary>Alle Orte nach Bundesland</summary>
        <div class="places-grid">
          {bundeslaender.map((b) => (
            <div>
              <h3>{b}</h3>
              <ul>{orteImLand(b).map((o) => <li><a href={link({ leistung, ort: o.slug })}>{o.name}</a></li>)}</ul>
            </div>
          ))}
        </div>
      </details>
    </div>
  </section>
</Base>
