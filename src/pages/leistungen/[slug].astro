---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import AdSlot from '../../components/AdSlot.astro';
import PriceCalc from '../../components/PriceCalc.astro';
import { leistungen, type Leistung } from '../../data/leistungen.ts';
import { einheitspreis } from '../../lib/preise.ts';
import { bundeslaender, orteImLand } from '../../data/orte.ts';

export function getStaticPaths() {
  return leistungen.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}
const { l } = Astro.props as { l: Leistung };
const others = leistungen.filter((o) => o.slug !== l.slug);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: l.name,
  description: l.text,
  provider: { '@type': 'Organization', name: 'Saubera' },
  areaServed: { '@type': 'Country', name: 'Deutschland' },
  audience: { '@type': 'BusinessAudience' },
};
---
<Base title={`${l.name} für Unternehmen: Kosten und Angebote`} description={`${l.name} für Gewerbe: ${l.kurz} Richtpreis ${einheitspreis(l)}. Vergleichbare Angebote geprüfter Fachbetriebe über Saubera.`} jsonLd={ld}>
  <section class="hero hero-sub">
    <div class="wrap">
      <div class="crumbs crumbs-dark"><a href="/">Start</a> / <a href="/leistungen">Leistungen</a> / {l.name}</div>
      <h1>{l.name}</h1>
      <p class="lead">{l.kurz} Richtpreis: {einheitspreis(l)} und Einsatz.</p>
      <PriceCalc slug={l.slug} />
    </div>
  </section>
  <section class="section">
    <div class="wrap editorial">
      <h2>Worum es geht</h2>
      <div class="editorial-body">
        <p>{l.text}</p>
        <dl class="facts">
          <dt>Leistungsumfang</dt><dd>{l.umfang.join(', ')}.</dd>
          <dt>Üblicher Turnus</dt><dd>{l.turnus}</dd>
          <dt>Geeignet für</dt><dd>{l.objekte.join(', ')}</dd>
        </dl>
      </div>
    </div>
    <div class="wrap mt-l"><AdSlot context={l.name} /></div>
  </section>
  <section class="section section-soft">
    <div class="wrap editorial">
      <h2>{l.name} in Ihrer Stadt</h2>
      <dl class="laender editorial-body">
        {bundeslaender.map((b) => <><dt>{b}</dt><dd>{orteImLand(b).map((o, i) => <>{i > 0 && ', '}<a href={`/leistungen/${l.slug}/${o.slug}`}>{o.name}</a></>)}</dd></>)}
      </dl>
    </div>
  </section>
  <section class="section">
    <div class="wrap editorial">
      <h2>Weitere Leistungen</h2>
      <ul class="link-list editorial-body">{others.map((o) => <li><a href={`/leistungen/${o.slug}`}>{o.name}</a> <span>{einheitspreis(o)}</span></li>)}</ul>
    </div>
  </section>
  <CtaBand href={`/anfrage?leistung=${l.slug}`} />
</Base>
