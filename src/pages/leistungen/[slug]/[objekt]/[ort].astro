---
import LeistungOrt from '../../../../components/LeistungOrt.astro';
import { leistungBySlug } from '../../../../data/leistungen.ts';
import { ortBySlug } from '../../../../data/orte.ts';
import { objektBySlug } from '../../../../data/objekte.ts';

export const prerender = false;

const l = leistungBySlug.get(Astro.params.slug ?? '');
const ort = ortBySlug.get(Astro.params.ort ?? '');
const objekt = objektBySlug.get(Astro.params.objekt ?? '');
if (!l || !ort || !objekt) return new Response(null, { status: 404 });
---
<LeistungOrt l={l} ort={ort} objekt={objekt} />
