---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base title="Werben auf Saubera" description="Premium-Platzierung und Anzeigen für Reinigungsfirmen und Anbieter von Reinigungsbedarf: sichtbar bei Unternehmen, die gerade eine Reinigung suchen.">
  <section class="page-head">
    <div class="wrap">
      <div class="crumbs"><a href="/">Start</a> / Werben</div>
      <h1>Sichtbar, wenn Unternehmen gerade suchen</h1>
      <p class="lead">Auf Saubera sind ausschließlich gewerbliche Auftraggeber unterwegs, die eine Reinigungsleistung brauchen. Erreichen Sie sie genau in diesem Moment.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="grid grid-3">
        <div class="card">
          <Icon name="star" class="icon" />
          <h3>Premium-Partner</h3>
          <p>Ihr Profil erscheint bei passenden Ausschreibungen weiter oben und mit Hervorhebung. Für Reinigungsfirmen, die schneller wachsen wollen.</p>
          <ul class="check-list mt-m"><li>Hervorgehobenes Profil</li><li>Vorrang bei gleicher Eignung</li><li>Logo und Referenzen</li></ul>
        </div>
        <div class="card">
          <Icon name="megaphone" class="icon" />
          <h3>Anzeige auf Leistungsseiten</h3>
          <p>Feste Platzierung auf einer Leistungsseite, zum Beispiel Glasreinigung oder Industriereinigung, bundesweit oder nach Region.</p>
          <ul class="check-list mt-m"><li>Als Anzeige gekennzeichnet</li><li>Nach Leistung und Region</li><li>Monatlich kündbar</li></ul>
        </div>
        <div class="card">
          <Icon name="building" class="icon" />
          <h3>Für Hersteller und Handel</h3>
          <p>Reinigungsmittel, Maschinen, Arbeitskleidung oder Software für Gebäudedienstleister: Erreichen Sie Reinigungsfirmen und Facility-Verantwortliche.</p>
          <ul class="check-list mt-m"><li>Partnerbereich der Reinigungsfirmen</li><li>Ratgeber-Sponsoring</li><li>Individuelle Pakete</li></ul>
        </div>
      </div>
      <p class="lead center mt-l">Preise und Verfügbarkeit nennen wir Ihnen gern persönlich. Registrieren Sie sich als Partner und kreuzen Sie „Premium-Platzierung“ an, oder fragen Sie als Hersteller direkt an.</p>
    </div>
  </section>
  <CtaBand title="Interesse an einer Platzierung?" text="Wir melden uns mit Preisen und freien Plätzen in Ihrer Region." href="/dienstleister/registrieren" label="Als Partner anfragen" />
</Base>
