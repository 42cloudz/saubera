---
// The operator's address block, or a marked placeholder until src/data/site.ts has it.
import { site } from '../data/site.ts';
const o = site.operator;
---
{o ? (
  <>
    <img class="operator-img" src={o.image} width="337" height="173" alt="Anschrift, Registereintrag, USt-IdNr. und inhaltlich Verantwortlicher des Betreibers" />
    <p>E-Mail: <a href={`mailto:${o.email}`}>{o.email}</a><br />Hotline: <a href={`tel:${o.phone.replace(/\s/g, '')}`}>{o.phone}</a></p>
  </>
) : (
  <p><span class="todo">Betreiberangaben folgen: Firmenname, Anschrift, E-Mail, Telefon</span></p>
)}
