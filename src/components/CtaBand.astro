---
interface Props { title?: string; text?: string; href?: string; label?: string }
const {
  title = 'Reinigung ausschreiben.',
  text = 'Für Auftraggeber kostenlos und unverbindlich.',
  href = '/anfrage',
  label = 'Angebot anfordern',
} = Astro.props;
---
<section class="strip">
  <div class="wrap strip-in">
    <p><strong>{title}</strong> {text}</p>
    <a class="btn btn-mint" href={href}>{label}</a>
  </div>
</section>
