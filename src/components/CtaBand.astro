---
interface Props { title?: string; text?: string; href?: string; label?: string }
const {
  title = 'Ihre Reinigung, ausgeschrieben in zwei Minuten.',
  text = 'Objekt beschreiben, Angebote vergleichen, entscheiden. Für Auftraggeber kostenlos.',
  href = '/anfrage',
  label = 'Angebote anfragen',
} = Astro.props;
---
<section class="strip">
  <div class="wrap strip-in">
    <p><strong>{title}</strong> {text}</p>
    <a class="btn btn-mint" href={href}>{label}</a>
  </div>
</section>
