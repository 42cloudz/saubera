---
// Shell of the customer area: Base plus a side navigation. Every page under /kunde uses it.
import Base from './Base.astro';
import { kunde } from '../data/kunde-demo.ts';

interface Props { title: string }
const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  { href: '/kunde', label: 'Übersicht' },
  { href: '/kunde/objekte', label: 'Leistungsverzeichnis' },
  { href: '/kunde/ausschreibungen', label: 'Ausschreibungen' },
  { href: '/kunde/nachweise', label: 'Leistungsnachweise' },
  { href: '/kunde/nacharbeiten', label: 'Nacharbeiten' },
  { href: '/kunde/vertrag', label: 'Vertrag und Anbieter' },
];
const active = (h: string) => (h === '/kunde' ? path === '/kunde' : path.startsWith(h));
---
<Base title={title}>
  <div class="demo-bar">Demo-Kundenbereich mit Beispieldaten. Änderungen werden nicht dauerhaft gespeichert.</div>
  <div class="portal wrap">
    <aside class="portal-side">
      <p class="portal-who"><strong>{kunde.firma}</strong><span>{kunde.name}</span></p>
      <nav aria-label="Kundenbereich">
        {nav.map((n) => <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <form method="post" action="/kunde/logout"><button class="portal-logout" type="submit">Abmelden</button></form>
    </aside>
    <div class="portal-main">
      <slot />
    </div>
  </div>
</Base>
