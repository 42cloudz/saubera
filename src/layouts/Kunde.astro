---
// Customer area: the shared app shell with the customer's navigation.
import App from './App.astro';
import { kunde } from '../data/kunde-demo.ts';

interface Props { title: string }
const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const items = [
  { href: '/kunde', label: 'Übersicht', icon: 'home' },
  { href: '/kunde/objekte', label: 'Leistungsverzeichnis', icon: 'list' },
  { href: '/kunde/ausschreibungen', label: 'Ausschreibungen', icon: 'scale' },
  { href: '/kunde/nachweise', label: 'Leistungsnachweise', icon: 'clipboard' },
  { href: '/kunde/nacharbeiten', label: 'Nacharbeiten', icon: 'flag' },
  { href: '/kunde/vertrag', label: 'Vertrag und Anbieter', icon: 'receipt' },
];
const nav = items.map((n) => ({ ...n, current: n.href === '/kunde' ? path === '/kunde' : path.startsWith(n.href) }));
---
<App title={title} area="kunde" nav={nav} user={{ name: kunde.name, sub: kunde.firma }} badge="Demo" home="/kunde" logout
  note="Demo mit Beispieldaten. Änderungen werden nicht dauerhaft gespeichert.">
  <slot />
</App>
